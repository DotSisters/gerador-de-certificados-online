{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "gerador-certificados-api",
    "Audience": "gerador-certificados-client",
    "AccessTokenMinutes": 60
  },
  "NewRelic": {
    "Enabled": true,
    "EndpointUrl": "https://log-api.newrelic.com/log/v1",
    "ApplicationName": "gerador-certificados-prod"
  },
  "AllowedHosts": "*"
}
